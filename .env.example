# Public (bundled into the client when prefixed with NEXT_PUBLIC_)
# Leave secrets empty. Copy this file to .env.local and fill in real values there.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Browser needs this to subscribe to Web Push. The private key stays server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-only. Never expose these to the client. Leave every secret empty.
SUPABASE_SERVICE_ROLE_KEY=
# Epitaph and task breakdown call the model with this key. If it is unset,
# both routes skip the network and use a deterministic fallback.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Site-wide model calls per UTC day. Past this, epitaphs and breakdowns use the fallback.
# Also set a spend limit on the OpenAI project. Each user is capped at 20 calls a day in code.
AI_DAILY_CAP=200
VAPID_PRIVATE_KEY=
CRON_SECRET=
# true when .github/workflows/remind.yml is calling /api/cron/remind hourly.
# The daily cron then skips its nag, and each user is nagged at their own local hour.
HOURLY_REMINDERS=false
# Gates demo fast-forward. Not a NEXT_PUBLIC_ variable, so the client bundle cannot turn it on.
DEMO_MODE=false
# HMAC key for the local demo session cookie. Server-only.
# Leave empty. When unset, the process generates a key and cookies do not survive a restart.
# Do not use a published placeholder. The server treats `your-demo-cookie-secret` as unset.
DEMO_COOKIE_SECRET=
