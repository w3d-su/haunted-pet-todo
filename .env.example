# Public (bundled into the client when prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Browser needs this to subscribe to Web Push. The private key stays server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Server-only. Never expose these to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
VAPID_PRIVATE_KEY=your-vapid-private-key
CRON_SECRET=your-cron-secret
# Gates demo fast-forward. Not a NEXT_PUBLIC_ variable, so the client bundle cannot turn it on.
DEMO_MODE=false
# HMAC key for the local demo session cookie. Server-only.
# Optional. When unset, the process generates a key and cookies do not survive a restart.
DEMO_COOKIE_SECRET=your-demo-cookie-secret
